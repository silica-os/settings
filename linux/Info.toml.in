# Settings as a Silica app bundle (silica-os docs/app-bundles.md): silica-packages and
# `cargo xtask os deploy` fill the placeholders and sign it. A system app: from /usr/Applications
# it runs without a sandbox; [permissions] is what a copy elsewhere is given.
# Settings changes the whole system: the session's settings (Settings1), the network, Bluetooth,
# power (system bus) and the privileged actions through polkit. A copy outside the system
# folders runs sandboxed, where there is no system bus: only the pages of the session work.
format = 1
id = "dev.frascella.Settings"
name = "Settings"
"name.it" = "Impostazioni"
generic_name = "System Settings"
comment = "Appearance, network, sound, Dock, keyboard and the other system settings"
version = "@VERSION@"
build = @BUILD@
minimum_silica = "0.2.0"
kind = "flutter"
runtime = "dev.silica.Platform//1"
args = ["--size", "832x780", "--title", "Settings", "--multi-window"]
categories = ["Settings", "System"]
keywords = ["settings", "preferences", "appearance", "wifi", "bluetooth", "sound", "dock", "keyboard", "impostazioni", "preferenze", "aspetto", "suono", "tastiera"]

[permissions]
network = false
devices = "gpu"
filesystem = ["home"]

[developer]
name = "Silica"
key = "@DEVELOPER_KEY@"
